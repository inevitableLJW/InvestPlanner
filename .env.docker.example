# Browser URL, including scheme and the externally visible port.
APP_URL=http://192.168.1.10:3000
APP_PORT=3000

# Use an absolute TrueNAS dataset path in production, for example:
# MYSQL_DATA_DIR=/mnt/tank/apps/invest-planner/mysql
MYSQL_DATA_DIR=./data/mysql
MYSQL_DATABASE=invest_planner
MYSQL_USER=invest_planner
MYSQL_PASSWORD=replace-with-a-long-random-password

# Keep false for direct HTTP access. Set both APP_URL=https://... and this to
# true when the app is served through an HTTPS reverse proxy.
COOKIE_SECURE=false
SESSION_TTL=168h
TZ=Asia/Shanghai
