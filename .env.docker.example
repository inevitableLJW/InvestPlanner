# Browser URL, including scheme and the externally visible port.
APP_URL=http://192.168.1.10:3000
APP_PORT=3000

# Local docker-compose.yml always uses the single named volume
# investplanner-mysql-data. TrueNAS host-path storage is configured separately
# by deploy/truenas-compose.yml.
MYSQL_DATABASE=invest_planner
MYSQL_USER=invest_planner
MYSQL_PASSWORD=replace-with-a-long-random-password

# Automatic mode supports direct HTTP and honors X-Forwarded-Proto for HTTPS.
COOKIE_SECURE=auto
SESSION_TTL=1h
TZ=Asia/Shanghai

# QDII data is always enabled. Set this only after the deployment owner has
# reviewed and accepted the upstream data terms for this self-hosted instance.
MARKET_DATA_PRODUCTION_APPROVED=false
FX_ASSISTANT_ENABLED=true
TUSHARE_TOKEN=
